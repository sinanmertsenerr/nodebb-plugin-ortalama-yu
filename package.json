{
  "name": "nodebb-plugin-ortalama-yu",
  "version": "1.0.3",
  "description": "GPA calculator for NodeBB, built for Yaşar University: pick your level and department, enter letter grades, see your term and cumulative averages by the university's own rules.",
  "main": "library.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinanmertsenerr/nodebb-plugin-ortalama-yu.git"
  },
  "scripts": {
    "data": "node tools/build-data.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test test/*.test.js",
    "dev": "node test/dev-server.mjs"
  },
  "keywords": [
    "nodebb",
    "plugin",
    "gpa",
    "student",
    "harmony"
  ],
  "author": "Sinan Mert Sener",
  "license": "MIT",
  "files": [
    "library.js",
    "plugin.json",
    "static/",
    "languages/",
    "README.md",
    "LICENSE"
  ],
  "nbbpm": {
    "compatibility": "^4.15.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "sass": "^1.104.1"
  }
}
